# Feytom — launch configuration.
#
# Copy to .env for local work. On Netlify these go in
# Site configuration → Environment variables.
#
# Nothing here has a permissive default: an unset variable always means
# "not approved yet". scripts/launch-guard.mjs refuses builds whose
# combination would publish something unapproved.

# ---------------------------------------------------------------------------
# STAGE — "review" (default) or "live".
#   review : every page emits noindex, robots.txt disallows all.
#   live   : indexable, sitemap generated. Requires PUBLIC_SITE_URL.
# ---------------------------------------------------------------------------
PUBLIC_SITE_STAGE=review

# ---------------------------------------------------------------------------
# CANONICAL URL — no trailing slash. Switches on canonical links + sitemap.
# Leave unset until the production domain is confirmed (§19: never guess it).
# ---------------------------------------------------------------------------
# PUBLIC_SITE_URL=https://www.example.com

# ---------------------------------------------------------------------------
# QUOTE DESTINATION — where quote requests are delivered.
#   netlify : Netlify Forms (current implementation)
#   (unset) : the form renders for review but cannot submit
# ---------------------------------------------------------------------------
# PUBLIC_QUOTE_DESTINATION=netlify

# ---------------------------------------------------------------------------
# PRIVACY NOTICE — set to true ONLY once owner/legal-approved privacy text is
# published at /privacy/. Gates the consent checkbox and, on a live build, the
# form itself. §19: do not collect production inquiries before the notice exists.
# ---------------------------------------------------------------------------
# PUBLIC_PRIVACY_APPROVED=true

# ---------------------------------------------------------------------------
# TEST SUBMISSIONS — review URL only. Enables the form before the privacy
# notice exists, with a visible "test environment" banner. The launch guard
# rejects this on a live build.
# ---------------------------------------------------------------------------
# PUBLIC_ALLOW_TEST_SUBMISSIONS=true

# ---------------------------------------------------------------------------
# PRICES (D26 — stage 1 of selling online)
# Publishing a price is an invitation to buy, so it is gated on there being
# approved terms of sale and a returns policy to buy under. Both flags are
# required; the launch guard refuses PUBLIC_SHOW_PRICES on its own.
#
# Delivery is NOT calculated at this stage. Prices exclude delivery and tax,
# every product page says so, and the delivered total is confirmed on the quote
# before any payment link is issued.
# ---------------------------------------------------------------------------
# PUBLIC_SHOW_PRICES=true
# PUBLIC_SALE_TERMS_APPROVED=true
