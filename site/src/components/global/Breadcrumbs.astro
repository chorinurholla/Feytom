---
/** Breadcrumb trail (§8.2/§8.4.1). Also feeds BreadcrumbList JSON-LD. */
export interface Crumb { label: string; href?: string }
interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol class="crumbs__list">
    {crumbs.map((c, i) => (
      <li class="crumbs__item">
        {c.href && i < crumbs.length - 1
          ? <a href={c.href} class="crumbs__link">{c.label}</a>
          : <span aria-current="page">{c.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs { padding-block: var(--space-2); }
  .crumbs__list {
    display: flex; flex-wrap: wrap; gap: var(--space-0-5) var(--space-1);
    list-style: none; margin: 0; padding: 0;
    font-size: var(--text-sm); color: var(--color-text-muted);
  }
  .crumbs__item + .crumbs__item::before {
    content: "/";
    margin-inline-end: var(--space-1);
    color: var(--color-border-strong);
  }
  .crumbs__link { color: var(--color-heading); }
  .crumbs__link:hover { text-decoration-thickness: 2px; }
  [aria-current="page"] { color: var(--color-text-muted); }
</style>
