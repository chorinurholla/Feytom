---
/**
 * Feytom logo — single point of resolution.
 *
 * PROVISIONAL ARTWORK. Generated by scripts/build-logo.py from the written
 * description of the "Open Loadlock" route (§10.1). When the client supplies
 * Feytom_Loadlock_Primary_*.svg, replace the files in src/assets/logos/ and
 * this component picks them up — no other file changes.
 */
import fullColour from "../../assets/logos/feytom-primary-full-colour.svg?raw";
import reversed from "../../assets/logos/feytom-primary-reversed.svg?raw";
import oneColourDark from "../../assets/logos/feytom-primary-one-colour-dark.svg?raw";
import iconFullColour from "../../assets/logos/feytom-icon-full-colour.svg?raw";
import iconReversed from "../../assets/logos/feytom-icon-reversed.svg?raw";

interface Props {
  variant?: "full-colour" | "reversed" | "one-colour-dark" | "icon" | "icon-reversed";
  /** Rendered height in px. Width follows the artwork's aspect ratio. */
  height?: number;
  /** Set true when a sibling element already provides the accessible name. */
  decorative?: boolean;
  class?: string;
}

const {
  variant = "full-colour",
  height = 40,
  decorative = false,
  class: className = "",
} = Astro.props;

const sources = {
  "full-colour": fullColour,
  reversed: reversed,
  "one-colour-dark": oneColourDark,
  icon: iconFullColour,
  "icon-reversed": iconReversed,
} as const;

// Aspect ratios come from the generated viewBoxes (lockup 234x64, icon 64x64).
const ratio = variant.startsWith("icon") ? 1 : 234 / 64;

let svg = sources[variant]
  .replace(/\swidth="[^"]*"/, "")
  .replace(/\sheight="[^"]*"/, "");

if (decorative) {
  svg = svg
    .replace(/\srole="img"/, ' role="presentation" aria-hidden="true" focusable="false"')
    .replace(/\saria-label="[^"]*"/, "")
    .replace(/<title>.*?<\/title>/, "");
}
---

<span
  class:list={["logo", className]}
  style={`--logo-h:${height}px;--logo-w:${Math.round(height * ratio)}px`}
  set:html={svg}
/>

<style>
  .logo {
    display: inline-block;
    line-height: 0;
  }
  .logo :global(svg) {
    height: var(--logo-h);
    width: var(--logo-w);
  }
</style>
