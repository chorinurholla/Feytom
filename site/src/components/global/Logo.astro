---
/**
 * Feytom logo — single point of resolution.
 *
 * This is the client's real mark, supplied 17 Aug 2026 and matching the mark
 * printed on the product packaging and woven into the lashing webbing. It
 * replaces the provisional "Open Loadlock" artwork, which is retired to
 * src/assets/logos/_superseded-provisional/.
 *
 * TWO THINGS THE SUPPLIED FILE CANNOT DO, and how this component works around
 * them until a vector is available:
 *
 * 1. The supplied artwork is a STACKED lockup whose chrome wordmark becomes
 *    illegible below roughly 90px tall — measured, not guessed. A site header is
 *    ~40px. So at header sizes this renders the MARK ONLY, paired with the
 *    wordmark typeset in Barlow Condensed, the site's display face. That is a
 *    stand-in for a proper horizontal lockup, which should come from whoever
 *    produced the logo.
 *
 * 2. It arrived as a 1254px PNG on a painted black background with no
 *    transparency. The background was flood-filled from the corners (a global
 *    black knockout would have punched holes in the mark's own deep navy), and
 *    the enclosed counter of the "O" cleared separately.
 *
 * A vector would remove both workarounds and is still worth asking for.
 */
import { Image } from "astro:assets";
import mark from "../../assets/logos/feytom-mark.png";
import stacked from "../../assets/logos/feytom-lockup-stacked.png";

interface Props {
  /** "horizontal" = mark + typeset wordmark (any size). "stacked" = the
      supplied lockup, only legible at 90px+. "mark" = symbol alone. */
  variant?: "horizontal" | "stacked" | "mark";
  /** Rendered height of the MARK in px (or of the lockup, when stacked). */
  height?: number;
  /** Colour of the typeset wordmark. Ignored by the stacked and mark variants. */
  tone?: "dark" | "light";
  /** Set true when a sibling element already provides the accessible name. */
  decorative?: boolean;
  class?: string;
}

const {
  variant = "horizontal",
  height = 34,
  tone = "dark",
  decorative = false,
  class: className = "",
} = Astro.props;

const alt = decorative ? "" : "Feytom";
---

{
  variant === "stacked" ? (
    <span class:list={["logo", className]}>
      <Image
        src={stacked}
        alt={alt}
        widths={[Math.round(height * 1.24), Math.round(height * 2.48)]}
        style={`height:${height}px;width:auto`}
        loading="eager"
      />
    </span>
  ) : (
    <span class:list={["logo", "logo--row", className]} data-tone={tone}>
      {/* In the horizontal variant the wordmark beside it is REAL TEXT, so the
          image carries no information and is hidden from assistive tech. In the
          mark-only variant the image is the only brand identification, so it
          takes the accessible name instead. */}
      <Image
        class="logo__mark"
        src={mark}
        alt={variant === "mark" ? alt : ""}
        aria-hidden={variant === "horizontal" ? "true" : undefined}
        widths={[Math.round(height * 1.77), Math.round(height * 3.54)]}
        style={`height:${height}px;width:auto`}
        loading="eager"
      />
      {
        variant === "horizontal" && (
          <span class="logo__word" style={`font-size:${Math.round(height * 0.78)}px`}>
            Feytom
          </span>
        )
      }
    </span>
  )
}

<style>
  .logo {
    display: inline-flex;
    line-height: 0;
  }
  .logo--row {
    align-items: center;
    gap: 0.34em;
  }
  .logo__mark {
    display: block;
  }
  .logo__word {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.045em;
    line-height: 1;
    /* Optical alignment: the mark's baseline sits slightly high against caps. */
    transform: translateY(0.045em);
  }
  .logo[data-tone="dark"] .logo__word {
    color: var(--color-heading);
  }
  .logo[data-tone="light"] .logo__word {
    color: var(--color-text-inverse);
  }
</style>
