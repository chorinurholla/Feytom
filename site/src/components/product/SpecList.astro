---
/**
 * Key specification block (§8.4.4).
 *
 * Specs whose sourceStatus is not "confirmed" are rendered in a distinct
 * pending state and labelled as unverified — never as plain fact. A pending
 * spec is a finding, not an error, so it is warning-toned and never red (§13:
 * colour never carries meaning alone, so the label carries it too).
 */
interface Spec { label: string; value: string; sourceStatus: string }
interface Props { specifications: Spec[]; caption?: string }
const { specifications, caption } = Astro.props;
---

{/* The caption must sit OUTSIDE the <dl>: only dt, dd, div, script and
    template are permitted children of a definition list. */}
{caption && <p class="sr-only">{caption}</p>}
<dl class="speclist">
  {specifications.map((s) => (
    <div class:list={["speclist__row", s.sourceStatus !== "confirmed" && "speclist__row--pending"]}>
      <dt class="speclist__label">{s.label}</dt>
      <dd class="speclist__value">
        {s.value}
        {s.sourceStatus === "pending" && (
          <span class="pendingtag">Not yet verified</span>
        )}
        {s.sourceStatus === "manufacturer_verified" && (
          <span class="verifiedtag">Manufacturer-verified</span>
        )}
      </dd>
    </div>
  ))}
</dl>

<style>
  .speclist__row--pending {
    box-shadow: inset 3px 0 0 var(--color-pending);
    padding-inline-start: var(--space-1);
  }
  .pendingtag,
  .verifiedtag {
    display: inline-block;
    margin-inline-start: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .pendingtag { color: var(--color-pending); }
  .verifiedtag { color: var(--color-success); }
</style>
