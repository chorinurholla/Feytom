---
/**
 * Home hero (§8.1.2).
 *
 * Copy rules applied: concrete nouns, no superlatives, no delivery promise,
 * no certification language, no price. Every claim here is traceable to the
 * approved company description (§3.5) or the confirmed product taxonomy.
 *
 * CTA hierarchy (CHALLENGE 4): exactly one filled orange action in this
 * viewport. "Explore Products" is filled because a cold visitor cannot write
 * a useful RFQ before seeing the range; "Request a Quote" is the outline
 * partner here and the emphasised action in the header.
 */
import StrapDevice from "./StrapDevice.astro";

const families = [
  { label: "Lashing", href: "/products?family=lashing" },
  { label: "Chains", href: "/products?family=chains" },
  { label: "Rope", href: "/products?family=rope" },
];
---

<section class="hero on-dark" aria-labelledby="hero-heading">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="t-eyebrow hero__eyebrow">Cargo Securement · Industrial Supply</p>

      <h1 id="hero-heading" class="t-hero hero__heading">
        Built for<br />the Work.
      </h1>

      <p class="t-lead hero__lead">
        Chains, lashing belts and industrial rope for transportation, warehouse
        and material-handling operations. Clear specifications, bulk quantities,
        and a straightforward route to pricing.
      </p>

      <div class="hero__actions">
        <a href="/products" class="btn btn--primary">Explore Products</a>
        <a href="/request-a-quote" class="btn btn--secondary">Request a Quote</a>
      </div>
    </div>

    {/* Reserved column. It holds the strap device and nothing else, which is
        what guarantees no text ever sits on orange. Removed below 60em.
        This is also the slot the hero photograph will occupy once approved
        product imagery exists (§19, "Approve product photography") — the
        straps are the honest placeholder, not a stand-in for a photo. */}
    <div class="hero__aside">
      <StrapDevice />
    </div>
  </div>

  <div class="hero__rail">
    <div class="container hero__rail-inner">
      <p class="t-eyebrow hero__rail-label">In the catalog</p>
      <ul class="hero__families">
        {
          families.map((f) => (
            <li>
              <a href={f.href} class="hero__family link">
                {f.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="t-small hero__rail-note">
        Bulk quantities available. Request pricing and availability.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background-color: var(--color-bg-inverse-deep);
    color: var(--color-text-inverse);
    overflow: hidden;
  }

  /* Restrained industrial grid — 8px system made visible, not a texture. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: linear-gradient(
        to right,
        rgb(255 255 255 / 0.055) 1px,
        transparent 1px
      ),
      linear-gradient(to bottom, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to bottom, #000 0%, transparent 88%);
  }

  .hero__inner {
    position: relative;
    padding-block: clamp(var(--space-8), 11vw, var(--space-16));
  }
  .hero__content {
    max-width: 34rem;
  }

  /* Below 60em there is no spare column, so the straps are removed entirely
     rather than shrunk onto the copy. The orange eyebrow, the primary action
     and the rail rule carry the brand at small sizes. */
  .hero__aside {
    display: none;
  }

  @media (min-width: 60em) {
    .hero__inner {
      display: grid;
      grid-template-columns: minmax(0, 40rem) minmax(14rem, 1fr);
      gap: var(--space-6);
      align-items: center;
    }
    .hero__aside {
      display: block;
      position: relative;
      align-self: stretch;
      /* Bleed to the section edge without ever crossing into the text column. */
      margin-inline-end: calc(var(--gutter) * -1);
      margin-block: calc(clamp(var(--space-8), 11vw, var(--space-16)) * -1);
      overflow: hidden;
    }
  }

  .hero__eyebrow {
    color: var(--color-accent-on-dark);
    margin-block-end: var(--space-2);
  }

  .hero__heading {
    color: var(--color-text-inverse);
    margin-block-end: var(--space-3);
  }

  .hero__lead {
    color: var(--color-text-inverse-muted);
    margin-block-end: var(--space-4);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
  }

  /* ---------- bottom rail ---------- */
  .hero__rail {
    position: relative;
    background: rgb(0 0 0 / 0.28);
    border-block-start: var(--rule-heavy) solid var(--color-accent-on-dark);
  }
  .hero__rail-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-2);
  }
  .hero__rail-label {
    color: var(--color-text-inverse-muted);
  }
  .hero__families {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hero__family {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    text-decoration: none;
    display: inline-block;
    padding-block: var(--space-0-5);
    border-block-end: 2px solid transparent;
  }
  .hero__family:hover {
    border-block-end-color: var(--color-accent-on-dark);
  }
  .hero__rail-note {
    color: var(--color-text-inverse-muted);
    margin-inline-start: auto;
  }
  @media (max-width: 47.99em) {
    .hero__rail-note {
      margin-inline-start: 0;
      flex-basis: 100%;
    }
  }
</style>
